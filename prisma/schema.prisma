generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Work {
  id          String   @id @default(cuid())
  workName    String
  costLakh    Float
  status      String
  category    String
  createdAt   DateTime @default(now())
}
